function fmtMoney(n) {
    var neg = n < 0;
    n = Math.abs(n);
    var s = (Math.round(n * 100) / 100).toString();
    if (s.indexOf('.') !== -1) {
        var p = s.split('.');
        if (p[1].length === 1) s = p[0] + '.' + p[1] + '0';
    }
    var parts = s.split('.');
    parts[0] = parts[0].replace(/\B(?=(\d{3})+(?!\d))/g, ',');
    return (neg ? '-$' : '$') + parts.join('.');
}
function fmtNum(n) {
    var s = (Math.round(n * 10000) / 10000).toString();
