    // Positive slope: y = mx + b.  Negative slope reads naturally as y = b - |m|x (e.g. B = 100 - 5h)
    if (m < 0) return yVar + ' = ' + fmtNum(b) + ' - ' + rateStr(Math.abs(m)) + xVar;
