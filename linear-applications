// ---------- persistence (task: save progress between sessions) ----------
var SAVE_KEY = 'linearAppsGame_v1';
function saveState() {
    try {
        // catRoundCount / catStars / appTimeMs were read back by loadState but
        // never written, so rounds, stars and time were silently lost between
        // sessions. They are persisted here.
        localStorage.setItem(SAVE_KEY, JSON.stringify({
            catCorrect: catCorrect, catAcc: catAcc, catShown: catShown,
            catRoundCount: catRoundCount, catStars: catStars, appTimeMs: appTimeMs,
            totalCorrect: totalCorrect, totalDone: totalDone, mixCelebrated: mixCelebrated,
            bestStreak: bestStreak,
        }));
    } catch (e) { /* storage unavailable (e.g. preview) -- play without saving */ }
}
// A student can edit localStorage from devtools, so nothing that comes back
// from it is trusted: every counter is rebuilt as a bounded non-negative
// integer, and "correct" is clamped so it can never exceed "attempted".
function sanitizeCounterMap(raw, keys, max) {
    var out = {};
    for (var i = 0; i < keys.length; i++) {
        var k = keys[i];
        out[k] = safeInt(raw && typeof raw === 'object' ? raw[k] : 0, max);
    }
    return out;
}
function sanitizeAccMap(raw) {
    var out = {};
    for (var k = 0; k <= 4; k++) {
        var o = (raw && typeof raw === 'object' && raw[k] && typeof raw[k] === 'object') ? raw[k] : {};
        var d = safeInt(o.d, STAT_MAX);
        var c = safeInt(o.c, STAT_MAX);
        if (c > d) c = d;
        out[k] = { c: c, d: d };
    }
    return out;
}
function loadState() {
    try {
        var raw = localStorage.getItem(SAVE_KEY);
        if (!raw) return;
        var st = JSON.parse(raw);
        if (!st || typeof st !== 'object') return;
        catCorrect = sanitizeCounterMap(st.catCorrect, [0, 1, 2, 3, 4], STAT_MAX);
        catAcc = sanitizeAccMap(st.catAcc);
        catShown = sanitizeCounterMap(st.catShown, [0, 1, 2, 3], STAT_MAX);
        catRoundCount = sanitizeCounterMap(st.catRoundCount, [0, 1, 2, 3, 4], ROUND_SIZE);
        catStars = sanitizeCounterMap(st.catStars, [0, 1, 2, 3, 4], 10000);
        totalDone = safeInt(st.totalDone, STAT_MAX);
        totalCorrect = Math.min(safeInt(st.totalCorrect, STAT_MAX), totalDone);
        appTimeMs = safeInt(st.appTimeMs, 1000 * 60 * 60 * 1000);
        bestStreak = safeInt(st.bestStreak, STAT_MAX);
        mixCelebrated = st.mixCelebrated === true;
    } catch (e) { /* ignore corrupt/unavailable storage */ }
}
function formatDuration(ms) {
    var totalSec = Math.round(ms / 1000);
    var h = Math.floor(totalSec / 3600);
    var m = Math.floor((totalSec % 3600) / 60);
    var sec = totalSec % 60;
    if (h > 0) return h + 'h ' + m + 'm';
    if (m > 0) return m + 'm ' + sec + 's';
    return sec + 's';
}
function clearSavedState() {
    try { localStorage.removeItem(SAVE_KEY); } catch (e) {}
}

// ---------- engine ----------
function setCategory(cat) {
    genToken++;             // invalidate timers left over from the old category
    category = cat;
    lifelines = FREE_MISTAKES;
    if (cat === 4) mixBag = [];
    updateDisplay();
    generateProblem();
    announce('Switched to ' + catNames[cat] + ' problems.');
}

function generateProblem() {
    genToken++;             // any timer aimed at the previous problem is now stale
    var cat = category === 4 ? nextMixCat() : category;
    currentCat = cat;
    catShown[cat] = safeInt(catShown[cat] + 1, STAT_MAX);
    if (cat === 0) currentProblem = makeCat1();      // Plug In (first category)
    else if (cat === 1) currentProblem = makeCat2();  // Build It
    else if (cat === 2) currentProblem = makeCat3();
    else currentProblem = makeCat4();
    partIndex = 0;
    lifelines = FREE_MISTAKES;
    missRecorded = false;
    renderProblem();
    document.getElementById('feedback').textContent = '';
    document.getElementById('hint').style.display = 'none';
    document.getElementById('answer-box').style.display = 'none';
    updateDisplay();
}

function renderDonePartHtml(dp, showVarLabels, showTitle) {
    var html = '<div class="part-box done">';
    if (showTitle) html += '<div class="part-title">' + dp.title + ' <span aria-hidden="true">&#10003;</span><span class="sr-only">, answered correctly</span></div>';
    html += '<div class="part-question">' + dp.question + '</div>';
    html += '<div class="input-area">';
    for (var k = 0; k < dp.blanks.length; k++) {
        var db = dp.blanks[k];
        var dpre = (db.alwaysPre || showVarLabels) && db.varPre ? '<span>' + db.varPre + '</span>' : '';
        var dsuf = db.suffix ? '<span>' + db.suffix + '</span>' : '';
        var dunit = (!db.suffix && db.unit) ? '<span class="unit-label">' + db.unit + '</span>' : '';
        html += dpre + '<span class="filled-answer">' + escapeHtml(fmtNum(db.answer)) + '</span>' + dsuf + dunit;
    }
    html += '</div>';
    if (dp.doneText) html += '<div class="done-eq-line">' + dp.doneText + '</div>';
    html += '</div>';
    return html;
}

// Everything a screen reader needs for the current problem, in words.
function spokenProblem(p, part, partNo, partTotal) {
    var out = [];
    if (category === 4) out.push('Mystery problem. First work out which kind it is.');
    out.push(speakText(p.story));
    if (p.defs) out.push('where ' + speakText(p.defs));
    if (p.equationLine) out.push('Equation: ' + speakText(p.equationLine));
    if (p.knownLineSpoken) out.push(p.knownLineSpoken);
    else if (p.knownLine) out.push(speakText(p.knownLine));
    if (partTotal > 1) out.push('Part ' + partNo + ' of ' + partTotal + '. ' + speakText(part.title));
    out.push(speakText(part.question));
    return out.join(' ');
}

function renderProblemComplete(praiseMsg) {
    var p = currentProblem;
    var showVarLabels = explicitMode();
    var html = '';
    if (category === 4) {
        html += '<div class="mastery-banner">Every problem is a mystery type. First step: figure out WHICH kind it is!</div>';
    }
    html += '<div class="ticket"><div class="ticket-tag">' + (category === 4 ? '???' : p.tag) + '</div><div class="ticket-story">' + p.story + '</div>';
    if (p.defs) html += '<div class="ticket-defs">where ' + p.defs + '</div>';
    if (p.equationLine) html += '<div class="ticket-eq">' + p.equationLine + '</div>';
    html += '</div>';
    if (p.knownLine) {
        html += '<div class="known-box">' +
            '<span aria-hidden="true">' + p.knownLine + '</span>' +
            '<span class="sr-only">' + (p.knownLineSpoken || p.knownLine) + '</span>' +
            '</div>';
    }
    for (var i = 0; i < p.parts.length; i++) {
        html += renderDonePartHtml(p.parts[i], showVarLabels, p.parts.length > 1);
    }
    document.getElementById('main-content').innerHTML = html;
    document.getElementById('feedback').textContent = praiseMsg;
    document.getElementById('feedback').className = 'feedback correct';
    document.getElementById('helper-buttons').style.display = 'none';
    document.getElementById('next-btn-wrap').style.display = 'block';
    announce(praiseMsg + ' Problem complete. Choose Next Problem to continue.');
}

function goToNextProblem() {
    genToken++;
    document.getElementById('next-btn-wrap').style.display = 'none';
    problemCount++;
    generateProblem();
}

function renderProblem() {
    var p = currentProblem;
    var part = p.parts[partIndex];
    var showVarLabels = explicitMode();
    var html = '';
    if (category === 4) {
        html += '<div class="mastery-banner">Every problem is a mystery type. First step: figure out WHICH kind it is!</div>';
    }
    html += '<div class="ticket"><div class="ticket-tag">' + (category === 4 ? '???' : p.tag) + '</div><div class="ticket-story">' + p.story + '</div>';
    if (p.defs) html += '<div class="ticket-defs">where ' + p.defs + '</div>';
    if (p.equationLine) html += '<div class="ticket-eq">' + p.equationLine + '</div>';
    html += '</div>';
    if (p.knownLine) {
        html += '<div class="known-box">' +
            '<span aria-hidden="true">' + p.knownLine + '</span>' +
            '<span class="sr-only">' + (p.knownLineSpoken || p.knownLine) + '</span>' +
            '</div>';
    }

    for (var i = 0; i < partIndex; i++) {
        html += renderDonePartHtml(p.parts[i], showVarLabels, p.parts.length > 1);
    }

    var wantsFrac = false;
    html += '<div class="part-box">';
    if (p.parts.length > 1) html += '<div class="part-title">' + part.title + '</div>';
    html += '<div class="part-question">' + part.question + '</div>';
    html += '<div class="input-area">';
    for (var j = 0; j < part.blanks.length; j++) {
        var bl = part.blanks[j];
        var pre = (bl.alwaysPre || showVarLabels) && bl.varPre ? '<span>' + bl.varPre + '</span>' : '';
        var suf = bl.suffix ? '<span>' + bl.suffix + '</span>' : '';
        var unit = (!bl.suffix && bl.unit) ? '<span class="unit-label">' + bl.unit + '</span>' : '';
        var lbl = (bl.varPre ? bl.varPre.replace(/[=\s]+$/, '') + ' value' : 'Answer') + (bl.unit ? ' in ' + bl.unit : '') + (part.blanks.length > 1 ? ' (box ' + (j + 1) + ' of ' + part.blanks.length + ')' : '');
        html += pre + '<input type="text" inputmode="decimal" id="answer-' + j + '" aria-label="' + escapeHtml(lbl) + '" placeholder="' + escapeHtml(bl.ph) + '" onfocus="setActiveField(this.id)" onkeypress="if(event.key===\'Enter\')checkAnswer()">' + suf + unit;
        if (bl.frac) wantsFrac = true;
    }
    html += '<button type="button" class="submit-btn" onclick="checkAnswer()">Submit</button>';
    html += '</div>';
    // On-screen keys: "+/-" always (iOS numeric pads have no minus), "/" only
    // where a fraction is a valid way to write the answer.
    html += '<div class="keypad" role="group" aria-label="Answer keys">';
    html += '<button type="button" class="key-btn" aria-label="Plus or minus: change the sign of the answer" onclick="toggleSignField()">+/-</button>';
    if (wantsFrac) html += '<button type="button" class="key-btn" aria-label="Divide: type the answer as a fraction" onclick="insertAtCursor(\'/\')">/</button>';
    html += '</div>';
    html += '</div>';

    document.getElementById('main-content').innerHTML = html;
    document.getElementById('helper-buttons').style.display = 'block';
    document.getElementById('next-btn-wrap').style.display = 'none';
    activeFieldId = 'answer-0';
    setTimeout(function () { var el = document.getElementById('answer-0'); if (el) el.focus(); }, 100);
    announce(spokenProblem(p, part, partIndex + 1, p.parts.length));
}

function checkAnswer() {
    if (!currentProblem || !currentProblem.parts[partIndex]) return;
    var part = currentProblem.parts[partIndex];
    var feedback = document.getElementById('feedback');
    // Check every box first: the old loop broke out on the first empty box,
    // leaving earlier boxes recoloured for a submission that never counted,
    // and told the student nothing about why nothing happened.
    var allFilled = true;
    for (var f = 0; f < part.blanks.length; f++) {
        var fe = document.getElementById('answer-' + f);
        if (!fe || fe.value.trim() === '') allFilled = false;
    }
    if (!allFilled) {
        feedback.textContent = part.blanks.length > 1
            ? 'Fill in every box before you submit.'
            : 'Type your answer before you submit.';
        feedback.className = 'feedback incorrect';
        var firstEmpty = null;
        for (var g = 0; g < part.blanks.length; g++) {
            var ge = document.getElementById('answer-' + g);
            if (ge && ge.value.trim() === '') { firstEmpty = ge; break; }
        }
        if (firstEmpty) firstEmpty.focus();
        return;
    }
    var allCorrect = true;
    for (var i = 0; i < part.blanks.length; i++) {
        var el = document.getElementById('answer-' + i);
        var val = parseUserNum(el.value);
        if (isNaN(val) || !isFinite(val) || Math.abs(val - part.blanks[i].answer) > 0.005) {
            allCorrect = false;
            // Never red: a wrong box is ink navy, and aria-invalid plus the
            // named box numbers in the feedback carry the information anyway.
            el.style.borderColor = '#1e2a5e';
            el.setAttribute('aria-invalid', 'true');   // not colour alone
        } else {
            el.style.borderColor = '#059669';   // dark mint: 3.77:1 on white
            el.setAttribute('aria-invalid', 'false');
        }
    }

    if (allCorrect) {
        document.getElementById('hint').style.display = 'none';
        document.getElementById('answer-box').style.display = 'none';
        if (partIndex < currentProblem.parts.length - 1) {
            feedback.textContent = 'Correct! Next part...';
            feedback.className = 'feedback correct';
            // Confetti is milestone-only now: finishing a part of a problem is
            // not a milestone, so nothing fires here.
            // >= 1100ms so the "Correct!" announcement finishes; the token check
            // stops a stale timer from advancing a part on a NEW problem (which
            // could index past the end of a single-part problem).
            var tokPart = currentToken();
            setTimeout(function () {
                if (tokPart !== currentToken()) return;
                if (!currentProblem || partIndex + 1 >= currentProblem.parts.length) return;
                partIndex++;
                renderProblem();
                feedback.textContent = '';
            }, 1200);
        } else {
            var statKey = category === 4 ? 4 : currentCat;
            catCorrect[statKey] = safeInt(catCorrect[statKey] + 1, STAT_MAX);
            catRoundCount[statKey] = safeInt(catRoundCount[statKey] + 1, ROUND_SIZE);
            if (!missRecorded) {
                totalCorrect++; totalDone++;
                catAcc[statKey].c++; catAcc[statKey].d++;
                // A revealed or already-missed problem does not extend the streak.
                streak++;
                if (streak > bestStreak) bestStreak = streak;
            }
            var roundCompleted = false;
            // ">=" not "==": a restored or clamped count must still award the star
            if (catRoundCount[statKey] >= ROUND_SIZE) {
                catStars[statKey] = safeInt(catStars[statKey] + 1, 10000);
                roundCompleted = true;
            }
            var justUnlocked = false;
            if (!mixCelebrated && allMastered()) {
                mixCelebrated = true;
                justUnlocked = true;
            }
            updateDisplay();
            if (justUnlocked) {
                createConfetti(220, 3);
                feedback.innerHTML = 'ALL FOUR TYPES MASTERED!<br><span style="font-size:15px;">Mix It! is calling your name...</span>';
                feedback.className = 'feedback correct';
                announce('All four types mastered. Mix It is now unlocked.');
                var tokUnlock = currentToken();
                setTimeout(function () {
                    if (tokUnlock !== currentToken()) return;
                    problemCount++;
                    generateProblem();
                }, 2600);
            } else if (streak === 10) {
                showVictoryScreen();
            } else if (roundCompleted) {
                showRoundComplete(statKey);
            } else {
                celebrateStreak(streak);
                renderProblemComplete(pick(['Excellent!', 'Nailed it!', 'Perfect!', 'Outstanding!', 'You got it!', 'Brilliant!']));
            }
        }
    } else {
        var wrongBoxes = [];
        for (var w = 0; w < part.blanks.length; w++) {
            var we = document.getElementById('answer-' + w);
            if (we && we.getAttribute('aria-invalid') === 'true') wrongBoxes.push(w + 1);
        }
        var which = part.blanks.length > 1 && wrongBoxes.length
            ? ' Check box ' + wrongBoxes.join(' and ') + '.'
            : '';
        if (lifelines > 0) {
            lifelines--;
            feedback.textContent = 'Incorrect attempt, please try again.' + which;
            feedback.className = 'feedback incorrect';
        } else {
            streak = 0;
            if (!missRecorded) {
                missRecorded = true;
                totalDone++;
                catAcc[category === 4 ? 4 : currentCat].d++;
            }
            feedback.textContent = 'Incorrect attempt, please try again.' + which;
            feedback.className = 'feedback incorrect';
        }
        updateDisplay();
    }
}

function toggleHint() {
    var hint = document.getElementById('hint');
    if (hint.style.display === 'none') {
        if (!currentProblem) return;
        hint.className = 'hint-box';
        hint.innerHTML = '<b>Hint:</b> ' + currentProblem.parts[partIndex].hint;
        hint.style.display = 'block';
        announce('Hint. ' + speakText(currentProblem.parts[partIndex].hint));
    } else hint.style.display = 'none';
}

/* Revealing the answer costs exactly what running out of free mistakes costs:
   the problem is booked as attempted, it can no longer earn the correct tally,
   and the streak ends. Without this a student could press Show Answer, type the
   numbers straight back and take clean first-try credit, which quietly inflated
   every accuracy figure. Show HINT stays free -- the hints here name the
   strategy ("what is the rate, and what is the starting amount?"), not the
   number. */
function recordReveal() {
    if (missRecorded || !currentProblem) return;
    missRecorded = true;
    totalDone++;
    catAcc[category === 4 ? 4 : currentCat].d++;
    streak = 0;
    updateDisplay();
    saveState();
    announce('Answer shown. This problem counts as attempted and the streak resets.');
}

function toggleAnswer() {
    var box = document.getElementById('answer-box');
    if (box.style.display === 'none') {
        if (!currentProblem) return;
        recordReveal();
        var part = currentProblem.parts[partIndex];
        var txt = [];
        for (var i = 0; i < part.blanks.length; i++) txt.push(escapeHtml(fmtNum(part.blanks[i].answer)));
        box.className = 'answer-box';
        box.innerHTML = '<b>Answer' + (txt.length > 1 ? 's' : '') + ':</b> ' + txt.join(', &nbsp;');
        box.style.display = 'block';
        announce('Answer' + (txt.length > 1 ? 's' : '') + ': ' + txt.join(', '));
    } else box.style.display = 'none';
}

function skipProblem() {
