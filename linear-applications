function pickXY(ctx) {
    var lo = 3, hi = 12;
    if (ctx.m < 0) {
        // largest multiplier that keeps y strictly positive
        var maxMult = Math.floor((ctx.b - 0.01) / (Math.abs(ctx.m) * ctx.xStep));
        hi = Math.max(1, Math.min(12, maxMult));
        lo = hi <= 3 ? 1 : 3;
    }
    var x = ctx.xStep * ri(lo, hi);
    return { x: x, y: ctx.m * x + ctx.b };
}

function makeCat1() {
    var ctx = pick(CONTEXTS_C1)();
    var eq = eqStr(ctx.m, ctx.b, ctx.yVar, ctx.xVar);
    var pt = pickXY(ctx);
    var x = pt.x, y = pt.y;
    var yS = ctx.money ? fmtMoney(y) : fmtNum(y);

    function givenXPart(title, xv, yv) {
        return {
            title: title,
            question: ctx.qX(xv),
            blanks: [{ varPre: ctx.yVar + ' = ', answer: yv, ph: '?', unit: ctx.yUnit }],
            hint: 'Substitute ' + fmtNum(xv) + ' for ' + ctx.xVar + ':  ' + ctx.yVar + ' = ' + substStr(ctx.m, ctx.b, '(' + fmtNum(xv) + ')')
        };
    }
    function givenYPart(title, xv, yv) {
        var yvS = ctx.money ? fmtMoney(yv) : fmtNum(yv);
        return {
            title: title,
            question: ctx.qY(ctx.money ? yvS : fmtNum(yv)),
            blanks: [{ varPre: ctx.xVar + ' = ', answer: xv, ph: '?', unit: ctx.xUnit }],
            hint: 'Set up: ' + fmtNum(yv) + ' = ' + substStr(ctx.m, ctx.b, ctx.xVar) + '.  ' + (ctx.b >= 0 ? 'Subtract ' + fmtNum(ctx.b) : 'Add ' + fmtNum(Math.abs(ctx.b))) + ' on both sides, then divide by ' + rateStr(ctx.m) + '.'
        };
    }

    var parts;
    if (Math.random() < 0.45) {
        // two-part: ask both directions with two different points
        var pt2 = pickXY(ctx);
        var guard = 0;
        while (pt2.x === x && guard < 15) { pt2 = pickXY(ctx); guard++; }
        if (Math.random() < 0.5) {
            parts = [givenXPart('Part A', x, y), givenYPart('Part B', pt2.x, pt2.y)];
        } else {
            parts = [givenYPart('Part A', x, y), givenXPart('Part B', pt2.x, pt2.y)];
        }
    } else if (Math.random() < 0.5) {
        parts = [givenXPart('Solve', x, y)];
    } else {
        parts = [givenYPart('Solve', x, y)];
    }
    return { tag: 'Plug In', story: ctx.story, defs: ctx.defs, equationLine: eq, parts: parts };
}

function makeCat2() {
    var ctx = pick(CONTEXTS_C1)();
    // ease-in: the first few Build It problems use positive slopes only,
    // then negative-slope contexts join the rotation
    var guard = 0;
    while (catRoundCount[1] < 2 && ctx.m < 0 && guard < 30) { ctx = pick(CONTEXTS_C1)(); guard++; }
    var pt = pickXY(ctx);
    var x = pt.x, y = pt.y;
    var giveX = Math.random() < 0.5;
    var yS = ctx.money ? fmtMoney(y) : fmtNum(y);
    var teach = category !== 4 && catShown[1] <= TRAINING_WHEELS;
    var signNote = (teach && ctx.m < 0) ? ' Careful: is the rate of change positive or negative?' : '';
    var partA = {
        title: 'Part A - Build the equation',
        question: 'Write the equation in the form ' + ctx.yVar + ' = m' + ctx.xVar + ' + b' + (teach ? ', where m is the rate of change and b is the starting value.' : '.') + signNote,
        blanks: [
            // frac: the rate of change is the one blank a student may want to
            // enter as a fraction (e.g. 1/4 for 0.25), so the "/" key is offered.
            { varPre: ctx.yVar + ' = ', answer: ctx.m, ph: 'm', suffix: ctx.xVar + ' + ', alwaysPre: true, frac: true },
            { answer: ctx.b, ph: 'b', alwaysPre: true }
        ],
        hint: 'm = how much ' + ctx.yVar + ' changes for each one ' + ctx.xVar + (ctx.m < 0 ? ' -- it is DECREASING, so m is negative.' : ' (' + rateStr(ctx.m) + ').') + '  b = the value at the very start, before anything happens (' + fmtNum(ctx.b) + ').',
        doneText: 'Equation: ' + eqStr(ctx.m, ctx.b, ctx.yVar, ctx.xVar)
    };
    var partB;
    if (giveX) {
        partB = {
            title: 'Part B - Use your equation',
            question: ctx.qX(x),
            blanks: [{ varPre: ctx.yVar + ' = ', answer: y, ph: '?', unit: ctx.yUnit }],
            hint: ctx.yVar + ' = ' + substStr(ctx.m, ctx.b, '(' + fmtNum(x) + ')')
        };
    } else {
        partB = {
            title: 'Part B - Use your equation',
            question: ctx.qY(ctx.money ? yS : fmtNum(y)),
            blanks: [{ varPre: ctx.xVar + ' = ', answer: x, ph: '?', unit: ctx.xUnit }],
            hint: fmtNum(y) + ' = ' + substStr(ctx.m, ctx.b, ctx.xVar) + ' -- move the constant to the other side, then divide by ' + rateStr(ctx.m) + '.'
        };
    }
    return { tag: 'Build It', story: ctx.story, defs: ctx.defs, equationLine: null, parts: [partA, partB] };
}

