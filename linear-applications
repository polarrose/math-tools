// ---------- stats panel ----------
// The old "My Results" replaced the whole problem area with a takeover card.
// The design system's pattern is a panel at the BOTTOM of the card, so the
// problem in progress is never destroyed and never re-generated -- which is a
// stronger form of the earlier M4 fix, not a rollback of it.
var statsOpen = false;
function toggleStatsPanel() {
    if (statsOpen) hideStats(); else showStats();
}
function hideStats() {
    statsOpen = false;
    document.getElementById('stats-panel').style.display = 'none';
    var b = document.getElementById('stats-btn');
    if (b) { b.setAttribute('aria-expanded', 'false'); b.focus(); }
    // Nothing was overwritten, so there is nothing to rebuild; the guard is
    // only for the case where the panel was opened before a first problem.
    if (!currentProblem) backToPractice();
}
function showStats() {
    renderStatsPanel();
    document.getElementById('stats-panel').style.display = 'block';
    statsOpen = true;
    var b = document.getElementById('stats-btn');
    if (b) b.setAttribute('aria-expanded', 'true');
    var done = safeInt(totalDone, STAT_MAX);
    var right = Math.min(safeInt(totalCorrect, STAT_MAX), done);
    var pct = done > 0 ? Math.round((right / done) * 100) : 0;
    announce('My stats. ' + (done > 0 ? pct + ' percent, ' + right + ' correct out of ' + done + ' problems.' : 'Nothing attempted yet.') + ' Best streak ' + safeInt(bestStreak, STAT_MAX) + '.');
}

function renderStatsPanel() {
    // Every number below can have come back from localStorage, so it is
    // re-coerced to a bounded integer before it is concatenated into innerHTML.
    var done = safeInt(totalDone, STAT_MAX);
    var right = Math.min(safeInt(totalCorrect, STAT_MAX), done);
    var pct = done > 0 ? Math.round((right / done) * 100) : 0;
    var timeStr = formatDuration(safeInt(appTimeMs, 1000 * 60 * 60 * 1000));
    var best = safeInt(bestStreak, STAT_MAX);

    var html = '<div class="stats-view">';
    html += '<h2>My Stats</h2>';
    html += '<div class="stats-overall">';
    html += '<div class="big">' + (done > 0 ? pct + '%' : '--') + '</div>';
    html += '<div class="lbl">Overall accuracy (' + right + ' / ' + done + ')</div>';
    html += '<div class="lbl" style="margin-top:4px;">Best streak: ' + best + '</div>';
    html += '<div class="lbl" style="margin-top:4px;">Time spent: ' + escapeHtml(timeStr) + '</div>';
    html += '</div>';

    for (var i = 0; i < 5; i++) {
        var n = safeInt(catRoundCount[i], ROUND_SIZE);
        var full = n >= ROUND_SIZE;
        var starCount = safeInt(catStars[i], 10000);
        var accD = safeInt(catAcc[i] ? catAcc[i].d : 0, STAT_MAX);
        var accC = Math.min(safeInt(catAcc[i] ? catAcc[i].c : 0, STAT_MAX), accD);
        // An untouched mode says so; it never shows "0/0", which reads like a
        // score rather than "not started".
        var numTxt, numSpoken;
        if (accD > 0) {
            var pc = Math.round((accC / accD) * 100);
            var pcls = pc >= 70 ? 'pct-good' : pc >= 50 ? 'pct-mid' : 'pct-low';
            numTxt = accC + ' / ' + accD + ' <span class="' + pcls + '">(' + pc + '%)</span>';
            numSpoken = accC + ' right out of ' + accD + ' attempted, ' + pc + ' percent';
        } else {
            numTxt = 'not tried yet';
            numSpoken = 'not tried yet';
        }
        var starTxt = starCount > 0 ? (starCount > 1 ? starCount + ' stars' : '1 star') : 'no stars yet';
        html += '<div class="stat-row">' +
            '<div class="stat-name">' + escapeHtml(catNames[i]) + '</div>' +
            '<div class="stat-num" aria-hidden="true">' + numTxt + '</div>' +
            '<div class="stat-meta" aria-hidden="true">' + ringSVG(n, ROUND_SIZE, full) +
            ' <span style="vertical-align:top;">' + n + '/' + ROUND_SIZE + ' this round -- ' + starTxt + '</span></div>' +
            '<div class="sr-only">' + escapeHtml(catNames[i]) + ': ' + numSpoken + '. ' +
            n + ' of ' + ROUND_SIZE + ' in this round, ' + starTxt + '.</div>' +
            '</div>';
    }
    html += '<div class="stats-actions"><button type="button" class="submit-btn" onclick="hideStats()">Back to Practice</button></div>';
    html += '</div>';

    document.getElementById('stats-panel').innerHTML = html;
}

// Kept from the earlier pass: if the practice view ever needs rebuilding it is
// re-rendered, never re-generated (re-generating inflated catShown and retired
// the training-wheel labels early).
function backToPractice() {
    document.getElementById('helper-buttons').style.display = 'block';
    if (currentProblem && currentProblem.parts[partIndex]) renderProblem();
    else generateProblem();
}

var resetArmed = false;
var resetTimer = null;
function resetAll() {
    var btn = document.getElementById('reset-btn');
    if (!resetArmed) {
        resetArmed = true;
        btn.textContent = 'Tap again to confirm';
        btn.style.background = '#1e2a5e';   // armed state is ink navy, never red
        announce('Tap Reset again to confirm clearing all progress.');
        resetTimer = setTimeout(function () {
            resetArmed = false;
            btn.textContent = 'Reset';
            btn.style.background = '';
        }, 4000);
        return;
    }
    genToken++;
    clearTimeout(resetTimer);
    resetArmed = false;
    btn.textContent = 'Reset';
    btn.style.background = '';
    streak = 0;
    bestStreak = 0;
    problemCount = 0;
    totalCorrect = 0;
    totalDone = 0;
    catCorrect = { 0: 0, 1: 0, 2: 0, 3: 0, 4: 0 };
    catAcc = { 0: {c:0,d:0}, 1: {c:0,d:0}, 2: {c:0,d:0}, 3: {c:0,d:0}, 4: {c:0,d:0} };
    catRoundCount = { 0: 0, 1: 0, 2: 0, 3: 0, 4: 0 };
    catStars = { 0: 0, 1: 0, 2: 0, 3: 0, 4: 0 };
    catShown = { 0: 0, 1: 0, 2: 0, 3: 0 };
    mixCelebrated = false;
    mixBag = [];
    appTimeMs = 0;
    lastTick = Date.now();
    clearSavedState();
    updateDisplay();
    generateProblem();
}

function allMastered() {
    for (var i = 0; i < 4; i++) { if (catStars[i] < 1) return false; }
    return true;
}

function ringSVG(n, goal, gold) {
    // solid pie: the whole wedge fills in as problems are solved, full circle at goal
    var cx = 21, cy = 21, r = 17;
    var pct = Math.max(0, Math.min(1, n / goal));
    // Midnight palette: violet while the round is in progress, mint when the
    // round is complete. No gold/amber, which reads as orange.
    var col = gold ? '#059669' : '#7c3aed';
    var svg = '<svg class="ring-svg" aria-hidden="true" focusable="false" width="42" height="42" viewBox="0 0 42 42">' +
        '<circle cx="21" cy="21" r="' + r + '" fill="#e6e9f6"/>';
    if (pct >= 0.999) {
        svg += '<circle cx="21" cy="21" r="' + r + '" fill="' + col + '"/>';
    } else if (pct > 0.001) {
        var angle = pct * 2 * Math.PI;
        var x = cx + r * Math.sin(angle);
        var y = cy - r * Math.cos(angle);
        var largeArc = pct > 0.5 ? 1 : 0;
        var d = 'M' + cx + ',' + cy + ' L' + cx + ',' + (cy - r) + ' A' + r + ',' + r + ' 0 ' + largeArc + ' 1 ' + x + ',' + y + ' Z';
        svg += '<path d="' + d + '" fill="' + col + '"/>';
    }
    return svg + '</svg>';
}

function startNewRound(stat) {
    genToken++;
    catRoundCount[stat] = 0;
    updateDisplay();
    generateProblem();
}

function showRoundComplete(stat) {
    createConfetti(170, 2);
    var starN = safeInt(catStars[stat], 10000);
    var name = escapeHtml(catNames[stat]);
    document.getElementById('main-content').innerHTML =
        '<div style="text-align:center;padding:30px;">' +
        '<div style="font-size:60px;" aria-hidden="true">&#9733;</div>' +
        '<div class="victory-title">Round Complete!</div>' +
        '<div style="font-size:16px;color:#1e2a5e;font-weight:700;margin:10px 0 4px 0;">' + name + ' -- star ' + starN + ' earned!</div>' +
        '<div style="font-size:14px;color:#4a5480;font-weight:700;margin-bottom:20px;">Ready for another batch of ' + ROUND_SIZE + '?</div>' +
        '<button type="button" class="submit-btn" onclick="startNewRound(' + Number(stat) + ')" style="font-size:17px;padding:14px 28px;">Start Another Round</button>' +
        '</div>';
    document.getElementById('feedback').textContent = '';
    document.getElementById('helper-buttons').style.display = 'none';
    announce('Round complete. ' + catNames[stat] + ', star ' + starN + ' earned. Choose Start Another Round to keep going.');
}

function renderMastery() {
    var html = '';
    for (var i = 0; i < 5; i++) {
        var n = safeInt(catRoundCount[i], ROUND_SIZE);
        var full = n >= ROUND_SIZE;
        var starCount = safeInt(catStars[i], 10000);
        var starsHtml = starCount > 0 ? '<span class="ring-star" aria-hidden="true">' + (starCount > 1 ? '&#9733;&times;' + starCount : '&#9733;') + '</span> ' : '';
        var btnCls;
        if (i === 4) {
            btnCls = category === 4 ? 'cat-btn mix active' : allMastered() ? 'cat-btn mix unlocked' : 'cat-btn mix';
        } else {
            btnCls = 'cat-btn' + (category === i ? ' active' : '');
        }
        var isActive = (category === i);
        var spoken = escapeHtml(catNames[i]) + ': ' + (starCount > 0 ? starCount + (starCount > 1 ? ' stars, ' : ' star, ') : '')
            + n + ' of ' + ROUND_SIZE + ' in this round';
        html += '<div class="cat-col" onclick="setCategory(' + i + ')">' +
            '<button type="button" class="' + btnCls + '" aria-pressed="' + (isActive ? 'true' : 'false') + '" ' +
            'aria-label="' + escapeHtml(catNames[i]) + ' problems. ' + spoken + '">' + escapeHtml(catNames[i]) + '</button>' +
            ringSVG(n, ROUND_SIZE, full) +
            '<div class="ring-stats" aria-hidden="true">' + starsHtml + n + '/' + ROUND_SIZE + '</div>' +
            '</div>';
    }
    document.getElementById('cat-row').innerHTML = html;
}

function updateDisplay() {
    document.getElementById('streak').textContent = streak;
    var sd = document.getElementById('streak-display');
    sd.className = streak >= 5 ? 'info-item streak-hot' : 'info-item';
    var lifeTxt = lifelines > 0 ? 'Second chances: ' + lifelines : 'No second chances left';
    document.getElementById('lifeline-display').textContent = lifeTxt;
    // clamp so a hand-edited store can never claim more correct than attempted
    totalDone = safeInt(totalDone, STAT_MAX);
    totalCorrect = Math.min(safeInt(totalCorrect, STAT_MAX), totalDone);
    var pct = totalDone > 0 ? Math.round((totalCorrect / totalDone) * 100) : 0;
    document.getElementById('score-text').textContent = totalDone > 0 ? totalCorrect + '/' + totalDone + ' (' + pct + '%)' : '0/0';
    var fill = document.getElementById('score-fill');
    fill.style.height = (totalDone > 0 ? pct : 0) + '%';
    fill.className = 'score-fill ' + (pct >= 70 ? 'good' : pct >= 50 ? 'mid' : 'low');
    renderMastery();
    if (statsOpen) renderStatsPanel();   // keep an open panel in step with play
    saveState();
}

// ---------- confetti (shared Midnight Scholar engine) ----------
// Pieces are fixed to the page, not appended to the card, so they are no longer
// clipped by the card's overflow:hidden; they fall the full viewport height and
// stay at full opacity the whole way down.
var CONFETTI_KEY = 'linearAppsGame_confetti_v1';
var confettiEnabled = true;
function loadConfettiPref() {
    try {
        var v = localStorage.getItem(CONFETTI_KEY);
        confettiEnabled = (v === null) ? true : v === '1';
    } catch (e) { confettiEnabled = true; }
}
function syncConfettiToggle() {
    var track = document.getElementById('confetti-track');
    var btn = document.getElementById('confetti-toggle');
    if (track) {
        if (confettiEnabled) track.className = 'toggle-track on';
        else track.className = 'toggle-track';
    }
    if (btn) btn.setAttribute('aria-checked', confettiEnabled ? 'true' : 'false');
}
function toggleConfetti() {
    confettiEnabled = !confettiEnabled;
    try { localStorage.setItem(CONFETTI_KEY, confettiEnabled ? '1' : '0'); } catch (e) { /* ignore */ }
    syncConfettiToggle();
    announce('Confetti ' + (confettiEnabled ? 'on' : 'off') + '.');
    if (confettiEnabled) createConfetti(40, 1);
}

// Milestones only, never every problem: streak 2 = tier 1, 4/6/8 = tier 2,
// 10 and every 4 thereafter = tier 3.
function celebrateStreak(s) {
    if (s === 2) createConfetti(40, 1);
    else if (s === 4) createConfetti(100, 2);
    else if (s === 6) createConfetti(140, 2);
    else if (s === 8) createConfetti(170, 2);
    else if (s >= 10 && (s - 10) % 4 === 0) createConfetti(200, 3);
}

function createConfetti(count, tier) {
    if (!confettiEnabled) return;
    if (prefersReducedMotion()) return; // a11y: no motion when the OS asks for none
    var host = document.body;
    // Eight colours, no orange and no red anywhere in the palette.
    var colors = ['#7c3aed', '#10b981', '#2e3d8f', '#0d9488', '#a78bfa', '#fde047', '#0369a1', '#be185d'];
    var isMassive = tier === 3;
    for (var i = 0; i < count; i++) {
        var piece = document.createElement('div');
        piece.className = 'confetti';
        piece.setAttribute('aria-hidden', 'true');
        var base;
        if (tier === 1) base = 7 + Math.random() * 5;
        else if (tier === 2) base = 10 + Math.random() * 7;
        else base = 11 + Math.random() * 9;
        var color = colors[Math.floor(Math.random() * colors.length)];
        var shape = Math.floor(Math.random() * 4);
        if (shape === 0) {                      // circle
            piece.style.width = base + 'px';
            piece.style.height = base + 'px';
            piece.style.background = color;
            piece.style.borderRadius = '50%';
        } else if (shape === 1) {               // rounded square
            piece.style.width = base + 'px';
            piece.style.height = base + 'px';
            piece.style.background = color;
            piece.style.borderRadius = '2px';
        } else if (shape === 2) {               // thin ribbon
            piece.style.width = Math.max(4, base * 0.35) + 'px';
            piece.style.height = (base * 1.7) + 'px';
            piece.style.background = color;
            piece.style.borderRadius = '2px';
        } else {                                // CSS-border triangle
            piece.style.width = '0';
            piece.style.height = '0';
            piece.style.background = 'transparent';
            piece.style.borderLeft = (base * 0.6) + 'px solid transparent';
            piece.style.borderRight = (base * 0.6) + 'px solid transparent';
            piece.style.borderBottom = base + 'px solid ' + color;
        }
        piece.style.left = Math.random() * 100 + '%';
        piece.style.top = '-20px';
        var dur;
        if (tier === 1) dur = 1.6 + Math.random() * 1.0;
        else if (tier === 2) dur = 2.0 + Math.random() * 1.5;
        else dur = 2.5 + Math.random() * 2.0;
        piece.style.animation = (isMassive ? 'confetti-fall-slow' : 'confetti-fall') + ' ' + dur + 's ease-out forwards';
        piece.style.animationDelay = (Math.random() * (isMassive ? 0.8 : 0.4)) + 's';
        host.appendChild(piece);
        setTimeout((function (el) { return function () { if (el.parentNode) el.parentNode.removeChild(el); }; })(piece), isMassive ? 7000 : 5000);
    }
    if (isMassive) {
        for (var j = 0; j < 15; j++) {
            var sp = document.createElement('div');
            sp.setAttribute('aria-hidden', 'true');
            sp.className = 'sparkle';
            sp.style.left = (Math.random() * 90 + 5) + '%';
            sp.style.top = (Math.random() * 70 + 10) + '%';
            sp.style.animationDelay = (Math.random() * 0.5) + 's';
            host.appendChild(sp);
            setTimeout((function (el) { return function () { if (el.parentNode) el.parentNode.removeChild(el); }; })(sp), 3000);
        }
    }
}

loadState();
loadConfettiPref();
syncConfettiToggle();
generateProblem();
updateDisplay();
setInterval(function () {
    var now = Date.now();
    appTimeMs += now - lastTick;
    lastTick = now;
}, 1000);
setInterval(saveState, 5000);
</script>
